# TuneBridge — окружение для docker compose.
# Скопируйте в .env и заполните. Файл .env в git не попадает.

# --- домен и HTTPS -----------------------------------------------------------
# Домен без схемы: Caddy сам получит сертификат Let's Encrypt.
TUNEBRIDGE_DOMAIN=tunebridge.example.com
TUNEBRIDGE_BASE_URL=https://tunebridge.example.com

# --- Telegram ----------------------------------------------------------------
# @BotFather → /newbot. Токен — полный доступ к боту, никому не показывайте.
TUNEBRIDGE_BOT_TOKEN=
TUNEBRIDGE_BOT_USERNAME=

# Секрет вебхука: длинная случайная строка, та же — при setWebhook.
TUNEBRIDGE_WEBHOOK_SECRET=

# Ключ шифрования подключений пользователей. Сгенерировать:
# python -c "import secrets; print(secrets.token_urlsafe(48))"
TUNEBRIDGE_SECRET_KEY=

# Ваш Telegram ID (узнать у @userinfobot), можно несколько через запятую.
TUNEBRIDGE_ADMIN_IDS=

# --- режим -------------------------------------------------------------------
# Бесплатный режим: без токенов, списаний и пополнений.
TUNEBRIDGE_FREE_MODE=1
# Cookie сессии только по HTTPS.
TUNEBRIDGE_COOKIE_SECURE=1

# --- реклама -----------------------------------------------------------------
# Пустые AD_TITLE и AD_URL — блок рекламы не показывается.
TUNEBRIDGE_AD_LABEL=Реклама
TUNEBRIDGE_AD_TITLE=
TUNEBRIDGE_AD_TEXT=
TUNEBRIDGE_AD_CTA=
TUNEBRIDGE_AD_URL=
# Картинка только с этого же домена: путь от корня, например /static/img/ads/banner.png
TUNEBRIDGE_AD_IMAGE=

# --- Android TWA -------------------------------------------------------------
# Пакет приложения и SHA-256 отпечаток подписи — для /.well-known/assetlinks.json.
TUNEBRIDGE_TWA_PACKAGE=
TUNEBRIDGE_TWA_SHA256=

# --- юридические страницы ----------------------------------------------------
# Оператор и контакт для /privacy и /terms. Почта приоритетнее Telegram.
TUNEBRIDGE_OPERATOR=
TUNEBRIDGE_CONTACT_EMAIL=
TUNEBRIDGE_CONTACT_TELEGRAM=

# --- защита публичного сервера ----------------------------------------------
# Лимиты запросов в минуту на IP и максимальный размер тела (байты).
# TUNEBRIDGE_RATE_LIMIT=1
# TUNEBRIDGE_RATE_GLOBAL=240
# TUNEBRIDGE_RATE_HEAVY=30
# TUNEBRIDGE_RATE_AUTH=12
# TUNEBRIDGE_MAX_BODY=8388608

# --- необязательно -----------------------------------------------------------
# TUNEBRIDGE_TRIAL_TOKENS=50
# TUNEBRIDGE_SESSION_TTL=2592000
# TUNEBRIDGE_STARS_RATE=2.0
